      "catalog_objective_text": "Calculate conditional probability from counts or a two-way table.",
      "question_format": "multiple_choice",
      "wording": "Which statements about P(A | B) are correct?",
      "answer_options": [
        {
          "option_id": "a",
          "text": "The denominator is the probability or count for B."
        },
        {
          "option_id": "b",
          "text": "It always equals P(B | A)."
        },
        {
          "option_id": "c",
          "text": "It can be calculated as P(A ∩ B) / P(B), when P(B) > 0."
        }
      ],
      "correct_answer_definition": {
        "grading": {
          "kind": "choice",
