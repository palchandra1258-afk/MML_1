# Backend-only Azure OpenAI settings. Copy to .env.backend and fill locally.
# Keep this file private and never place these values in frontend/.env.local.
AZURE_OPENAI_ENDPOINT=''
AZURE_OPENAI_API_KEY=''
AZURE_OPENAI_DEPLOYMENT_NAME=''
AZURE_OPENAI_API_VERSION=''

# Backend-only text-generation provider: azure (default), gemini, or mock (tests only).
AI_PROVIDER='azure'
GEMINI_API_KEY=''
GEMINI_MODEL=''
# GEMINI_TIMEOUT_SECONDS='30'

# Optional bounded client controls (defaults: 30 seconds and 2 retries).
# AZURE_OPENAI_TIMEOUT_SECONDS='30'
# AZURE_OPENAI_MAX_RETRIES='2'
